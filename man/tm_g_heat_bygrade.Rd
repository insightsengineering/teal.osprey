        choices = teal.picks::is_categorical(min.len = 2),
        selected = 1L
      ),
      visit_var = variables(
        choices = dplyr::starts_with("AVISIT"),
        selected = 1L
      ),
      ongo_var = variables(
        choices = dplyr::starts_with("ongo"),
        selected = 1L
      ),
