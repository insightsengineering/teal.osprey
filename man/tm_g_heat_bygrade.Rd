        selected = c("SEX", "COUNTRY"),
        multiple = TRUE
      ),
      heat_var = variables(
        choices = dplyr::starts_with("AETO"),
        selected = 1L
      ),
      conmed_var = variables(
        choices = dplyr::starts_with("CMDECOD"),
        selected = 1L
